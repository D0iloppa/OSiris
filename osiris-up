#!/usr/bin/env bash
# osiris-up — [1단계] docker-compose 부트스트랩 (docs/design/10-core-architecture.md §4.1)
#
# 이번 구현 범위는 "플랫폼 계층과 진입 경로"까지다. §4.1의 8단계 중
# 0~5, 그리고 8을 대체하는 완료 배너까지만 수행한다. 6(상위 게이트웨이 설치)은
# 프레임워크 밖의 일이고(아래 6단계 주석), 7(watchdog)과
# 카탈로그 시드/관리자 토큰(osiris-core가 있어야 가능)은 다음 워커의 몫이다.
# 자세한 근거는 docs/design/IMPLEMENTATION-NOTES.md.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

log()  { echo "[osiris-up] $*"; }
die()  { echo "[osiris-up] ERROR: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# 0. preflight — 실패 시 즉시 중단 (부분 설치 금지)
# ---------------------------------------------------------------------------
log "0. preflight"

command -v docker >/dev/null 2>&1 || die "docker가 필요합니다"
docker compose version >/dev/null 2>&1 || die "docker compose v2가 필요합니다"

DOCKER_MAJOR="$(docker version --format '{{.Server.Version}}' | cut -d. -f1)"
[ "$DOCKER_MAJOR" -ge 24 ] || die "Docker Engine >= 24 필요 (현재 $DOCKER_MAJOR)"

[ -f .env ] || die ".env가 없습니다. 'cp .env.example .env && \$EDITOR .env' 먼저 실행하세요"
# shellcheck disable=SC1091
set -a; source .env; set +a

# I5 2차 수정(사용자 지시): 외부 네트워크(dev-net류)는 이 프레임워크의 기본
# 설치에 필요 없다 — 이식성. `.env`의 `DEV_NET_NAME`이 비어 있으면(기본값)
# 표준 설치로 진행하고, 값이 있으면 그 네트워크가 실제로 존재하는지 확인한
# 뒤에만 `docker-compose.dev-net.yml` 오버레이를 함께 적용한다. 값이 있는데
# 네트워크가 없으면(사용자가 명시적으로 그 통합을 의도했다는 뜻이므로) 죽는다
# — 조용히 표준 설치로 대체하지 않는다.
COMPOSE_FILES=(-f docker-compose.yml)
if [ -n "${DEV_NET_NAME:-}" ]; then
  docker network inspect "$DEV_NET_NAME" >/dev/null 2>&1 \
    || die "DEV_NET_NAME='$DEV_NET_NAME'이 .env에 설정되어 있지만 그 네트워크가 없습니다. 이 스크립트는 만들지 않습니다(호스트 안전 — 재사용만). 외부 네트워크 통합이 필요 없다면 .env에서 DEV_NET_NAME을 비우세요"
  COMPOSE_FILES+=(-f docker-compose.dev-net.yml)
  DEV_NET_STATUS="dev-net('$DEV_NET_NAME') 오버레이 사용"
else
  DEV_NET_STATUS="외부 네트워크 없음(표준/이식형 설치) — osiris-gw는 127.0.0.1:${OSIRIS_GW_HOST_PORT:-18280}에서만 응답"
fi

# omniroute 모드: embedded(기본 — 전용 인스턴스를 소스 빌드해 띄움) 또는
# external(이미 운용 중인 omniroute에 붙음 — 설치 skip, osiris-omniroute는 고정
# 대상 중계로 대체). 근거·차이는 docker-compose.omniroute-external.yml 헤더 주석.
case "${OSIRIS_OMNIROUTE_MODE:-embedded}" in
  embedded)
    OMNI_STATUS="omniroute: embedded(osiris-omniroute 빌드·기동)"
    ;;
  external)
    [ -n "${OSIRIS_OMNIROUTE_EXTERNAL_NET:-}" ] && [ -n "${OSIRIS_OMNIROUTE_EXTERNAL_ADDR:-}" ] \
      || die "OSIRIS_OMNIROUTE_MODE=external 에는 OSIRIS_OMNIROUTE_EXTERNAL_NET·OSIRIS_OMNIROUTE_EXTERNAL_ADDR 가 필요합니다"
    docker network inspect "$OSIRIS_OMNIROUTE_EXTERNAL_NET" >/dev/null 2>&1 \
      || die "OSIRIS_OMNIROUTE_EXTERNAL_NET='$OSIRIS_OMNIROUTE_EXTERNAL_NET' 네트워크가 없습니다(이 스크립트는 만들지 않습니다 — 외부 omniroute가 붙어 있는 망 이름을 적으세요)"
    for v in OSIRIS_GATEWAY_BASE_URL OSIRIS_OMNIROUTE_BASE_URL; do
      case "${!v:-}" in
        http://osiris-omniroute:20128|http://osiris-omniroute:20128/) ;;
        *) die "external 모드에서는 $v=http://osiris-omniroute:20128 (\`/omni\` 없이)이어야 합니다 — 현재 '${!v:-<비어 있음>}'" ;;
      esac
    done
    COMPOSE_FILES+=(-f docker-compose.omniroute-external.yml)
    OMNI_STATUS="omniroute: external(${OSIRIS_OMNIROUTE_EXTERNAL_ADDR} @ ${OSIRIS_OMNIROUTE_EXTERNAL_NET}, 설치 skip)"
    ;;
  *) die "OSIRIS_OMNIROUTE_MODE='${OSIRIS_OMNIROUTE_MODE}' — embedded 또는 external 만 허용" ;;
esac
DEV_NET_STATUS="${DEV_NET_STATUS}, ${OMNI_STATUS}"

AVAIL_KB="$(df -Pk "$ROOT" | awk 'NR==2{print $4}')"
AVAIL_GB=$((AVAIL_KB / 1024 / 1024))
[ "$AVAIL_GB" -ge 60 ] || die "디스크 여유 60GiB 필요 (현재 ${AVAIL_GB}GiB)"

TOTAL_MEM_KB="$(awk '/MemTotal/{print $2}' /proc/meminfo)"
TOTAL_MEM_GB=$((TOTAL_MEM_KB / 1024 / 1024))
[ "$TOTAL_MEM_GB" -ge 8 ] || die "RAM 8GiB 필요 (현재 ${TOTAL_MEM_GB}GiB)"

log "   docker >= 24, compose v2, ${DEV_NET_STATUS}, 디스크 ${AVAIL_GB}GiB, RAM ${TOTAL_MEM_GB}GiB — OK"

# ---------------------------------------------------------------------------
# 1. 내부 네트워크 — docker-compose.yml이 이미 osiris-edge/osiris-data/
#    osiris-agents를 internal:true + 고정 subnet으로 선언하므로, 별도의
#    `docker network create`를 먼저 돌리지 않는다(`docker compose up` 자체가
#    멱등하게 생성/재사용한다). 설계 §4.1의 별도 스텝과 결과는 동일하다 —
#    구현 판단 근거는 IMPLEMENTATION-NOTES.md 참조.
# ---------------------------------------------------------------------------
log "1. 내부 네트워크는 docker compose가 생성/재사용합니다 (osiris-edge/osiris-data/osiris-agents)"

# ---------------------------------------------------------------------------
# 2. 호스트 상태 디렉토리 (0700, orchestrator 전용 — 지금은 osiris-orchestrator가
#    없으므로 실제 사용자는 없지만, 자리와 권한 관례를 먼저 세운다)
# ---------------------------------------------------------------------------
log "2. 호스트 상태 디렉토리 생성 (0700)"
mkdir -p state/creds state/config state/backup
chmod 700 state state/creds state/config state/backup

# ---------------------------------------------------------------------------
# 3. docker compose up -d — 코어 서비스만. 에이전트 0개 (G4).
# ---------------------------------------------------------------------------
# 이 시각을 기준으로 뒤 8단계에서 "osiris-api가 이번 실행에서 새로 설정
# 토큰을 생성했는지"를 osiris-api 로그의 since 필터로 좁혀 판별한다(초
# 단위 유닉스 타임스탬프 — `docker compose logs --since`가 그대로 받는다).
UP_START_TS="$(date -u +%s)"
log "3. docker compose up -d (${COMPOSE_FILES[*]})"
docker compose "${COMPOSE_FILES[@]}" up -d

# ---------------------------------------------------------------------------
# 4. Neo4j Ready 대기 → 스키마(제약/인덱스) 적용.
#    카탈로그 시드(Capability/Permission/PermissionProfile/AssignmentPolicy/
#    OrgRevision=0)는 graph-write API 경유가 원칙이라(D17, G7) 이번 단계에서는
#    하지 않는다 — osiris-core가 없다.
# ---------------------------------------------------------------------------
log "4. Neo4j 스키마(제약/인덱스) 적용 대기·실행"
./neo4j/apply-schema.sh

# ---------------------------------------------------------------------------
# 5. osiris-gw 상태/랜딩 정적 페이지 렌더 (osiris-api/콘솔이 없으므로 이
#    페이지들이 osiris-gw의 `/`, `/pre-status`를 200으로 만든다)
# ---------------------------------------------------------------------------
log "5. osiris-gw 플레이스홀더 상태 페이지 렌더"
./gw/render-status.sh

# ---------------------------------------------------------------------------
# 5b. [I4] 에이전트 런타임 이미지 빌드 (§5.1).
#     compose 서비스가 아니라 별도 스크립트인 이유는 bin/build-agent-image.sh
#     헤더 주석 참조(G4 — compose에는 코어 서비스만). 에이전트 컨테이너는
#     osiris-orchestrator가 Docker Engine API로 만든다(A11).
# ---------------------------------------------------------------------------
log "5b. 에이전트 런타임 이미지 빌드 (osiris/agent) — bin/build-agent-image.sh"
./bin/build-agent-image.sh

# ---------------------------------------------------------------------------
# 5c. [I5] osiris-omniroute — 부트스트랩은 여기서 끝난다. 이 스크립트는
#     osiris-omniroute에 프로바이더 자격증명·별칭·게이트웨이 토큰을 절대
#     적용하지 않는다 — 그건 온보딩(30-onboarding-provisioning.md)의 몫이다
#     (사용자 확정: "온보딩에서 결정할 것을 미리 하지 마라. OSiris는 하나의
#     프레임워크다 — MSA 형태일 뿐, 부트스트랩은 빈 스택을 띄우는 것까지").
#     osiris-omniroute는 구성되지 않은 채로 healthy해야 정상이다(빈 DB로
#     기동, healthcheck는 무인증 /v1/models라 빈 상태에서도 200).
#     온보딩 파이프라인이 호출할 오퍼레이션은 `omniroute/operations.mjs`
#     (계약은 그 파일 헤더 주석 + IMPLEMENTATION-NOTES.md I5 §52 참고) —
#     이 스크립트는 그것도 호출하지 않는다.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 6. 상위 게이트웨이 설치 — 프레임워크 계약상 osiris-gw **밖**의 일이다
#    (§2, 예시 배포는 상위 리버스 프록시 + docker-compose.dev-net.yml 오버레이
#    조합이다 — 그 프록시 설정은 OSiris 밖의 자산이라 이 스크립트도,
#    OSiris의 어떤 코드도 절대 건드리지 않는다).
# ---------------------------------------------------------------------------
log "6. 상위 게이트웨이: 프레임워크 계약 밖(§2) — osiris-gw가 포트에서 수신하고, 있다면 상위가 그 앞에 놓인다"
log "   상위 리버스 프록시를 쓴다면 DEV_NET_NAME 오버레이로 붙이며, 그 프록시 설정은 건드리지 않습니다."

# ---------------------------------------------------------------------------
# 7. osiris-watchdog (호스트 systemd) — 이번 단계 범위 밖. §10.3/D11 참조.
# ---------------------------------------------------------------------------
log "7. osiris-watchdog systemd 유닛: 이번 구현 범위 밖 (IMPLEMENTATION-NOTES.md 참조) — 건너뜀"

# ---------------------------------------------------------------------------
# 8. 마스터 키 — osiris-api가 최초 기동 시 자동 생성해
#    state/creds/admin/master_key에 쓴다(api/internal/masterkey). 감독
#    실측(2026-07-27): 이 값이 조작자에게 보이는 곳이 지금까지 아무 데도
#    없어서("호스트 파일을 cat하세요"만 안내) "어디서든 설치되는
#    프레임워크"의 첫 경험치고 불필요한 마찰이 있었다 — Jupyter/Gitea류
#    셀프호스팅 도구의 관례(부트스트랩이 끝나면 터미널에 접속 정보를 바로
#    보여준다)를 따라 여기서 표면화한다.
#
#    **최초 생성 시에만 값 자체를 출력한다** — 재기동 때마다 찍으면
#    시크릿이 셸 히스토리/스크롤백/CI 로그에 반복 축적된다(작업 지시
#    필수 요구사항: 시크릿을 로그에 남기지 않는다 — 이건 "조작자가 직접
#    실행한 커맨드의 stdout"이라 예외지만, 그래도 반복 출력할 이유가
#    없다).
#
#    ★ [H10/H23] 파일이 **없는 것이 정상인 상태가 생겼다.** 초기 관리자가
#    비밀번호를 세우면 마스터 키는 영구 폐기되고 파일이 삭제된다(§4.5).
#    그래서 이 단계는 더 이상 "파일이 없으면 실패"가 아니다 — osiris-api의
#    기동 로그가 네 결과(generated/loaded/withheld/undeterminable) 중
#    무엇을 말하는지 보고 분기한다. 그 로그 문구가 계약이며,
#    cmd/osiris-api/main.go의 switch와 짝을 이룬다.
#
#    **파일 대기를 조건부로 만든 이유**: 인수인계가 끝난 배포에서는 파일이
#    영원히 나타나지 않으므로, 무조건 90초를 기다리면 매 기동마다 90초를
#    버린다. 그래서 "파일" 또는 "설명하는 로그 한 줄" 중 먼저 오는 쪽을
#    기다린다.
# ---------------------------------------------------------------------------
log "8. 마스터 키 확인"

KEY_PATH="$ROOT/state/creds/admin/master_key"

api_logs() {
  docker compose "${COMPOSE_FILES[@]}" logs --since "$UP_START_TS" osiris-api 2>/dev/null || true
}
# 네 결과 중 무엇이든 나타났으면 더 기다릴 이유가 없다.
key_decided() {
  api_logs | grep -qE "the OSiris master key|no master key exists|could not read the org revision at boot"
}

# osiris-api가 NATS 연결(최대 재시도 ~60초)을 마친 뒤에야 마스터 키를
# 생성/로드하므로(cmd/osiris-api/main.go의 run() 순서), 최대 90초 대기한다 —
# 조용히 건너뛰지 않는다.
WAITED=0
while [ ! -f "$KEY_PATH" ] && ! key_decided && [ "$WAITED" -lt 90 ]; do
  sleep 3
  WAITED=$((WAITED + 3))
done

GW_URL="http://127.0.0.1:${OSIRIS_GW_HOST_PORT:-18280}/"
API_LOGS="$(api_logs)"

if printf '%s' "$API_LOGS" | grep -q "generated the OSiris master key"; then
  echo
  log "   OSiris 준비 완료."
  echo "     콘솔:        ${GW_URL}"
  echo "     마스터 키:   $(cat "$KEY_PATH")"
  echo
  log "   이 값으로 콘솔에 최초 로그인합니다 → 조직 생성 → 본인 비밀번호 설정."
  log "   비밀번호를 설정하는 순간 이 마스터 키는 영구히 폐기됩니다(H23)."
  log "   지금 1회만 출력됩니다. 다시 보려면: bin/show-master-key.sh"
elif printf '%s' "$API_LOGS" | grep -q "no master key exists"; then
  log "   콘솔: ${GW_URL}"
  log "   마스터 키는 이미 폐기되었습니다 — 인수인계가 끝난 정상 상태입니다(H23)."
  log "   관리자 본인의 email + 비밀번호로 로그인하세요. 자격증명 분실 시에는 새"
  log "   마스터 키가 아니라 break-glass 복구 경로를 씁니다(60-identity-authn.md §9)."
elif printf '%s' "$API_LOGS" | grep -q "could not read the org revision at boot"; then
  log "   경고: osiris-api가 기동 시 조직 리비전을 읽지 못해 마스터 키 판정을 보류했습니다."
  log "   Neo4j가 올라오기 전까지 모든 마스터 키 경로는 거부됩니다(fail-closed, §4.3)."
  log "   'docker compose logs osiris-neo4j'를 확인하세요."
elif [ -f "$KEY_PATH" ]; then
  log "   콘솔: ${GW_URL}"
  log "   기존 마스터 키가 있습니다 — 다시 보려면: bin/show-master-key.sh (파일을 직접 열어볼 필요 없음)"
else
  log "   마스터 키 상태를 판정할 로그가 없습니다 — osiris-api가 기동하지 못했을 수 있습니다. 'docker compose logs osiris-api'로 확인하세요."
fi

echo
log "=== 헬스 요약 ==="
for c in osiris-gw osiris-neo4j osiris-nats osiris-egress osiris-omniroute osiris-core osiris-orchestrator osiris-api; do
  st="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$c" 2>/dev/null || echo "missing")"
  printf '   %-18s %s\n' "$c" "$st"
done

DEFAULT_ORIGIN="http://localhost:${OSIRIS_GW_HOST_PORT:-18280}"
if command -v curl >/dev/null 2>&1; then
  CODE="$(curl -sS -o /dev/null -w '%{http_code}' "${PUBLIC_ORIGIN:-$DEFAULT_ORIGIN}/" --max-time 5 || echo "curl-failed")"
  log "GET ${PUBLIC_ORIGIN:-$DEFAULT_ORIGIN}/ -> ${CODE}"
fi

log "완료. 콘솔에서 온보딩 0단계(결정적 스택 배선)를 진행할 수 있습니다 — 위 콘솔 URL을 열고 설정 토큰을 입력하세요."
