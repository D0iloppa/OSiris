# OSiris [1단계] 환경 설정 예시.
# 사용법: cp .env.example .env && $EDITOR .env
# 절대 .env 자체를 커밋하지 말 것 (.gitignore에 이미 등록됨). 여기 값은 전부 placeholder.

# ---------------------------------------------------------------------------
# compose 프로젝트 이름 — 고정해 둔다. 지정하지 않으면 compose가 디렉토리 이름을
# 소문자화해 쓰는데, 그러면 컨테이너/네트워크 이름(예: <project>_osiris-agents)이
# 체크아웃 디렉토리 이름에 따라 달라져 스크립트(bin/verify-isolation.sh 등)의
# 네트워크 이름 가정이 깨질 수 있다.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=osiris

# ---------------------------------------------------------------------------
# 외부 진입 / 게이트웨이 이음새 (§2)
#
# I5 2차 수정(사용자 지시): OSiris는 특정 사이트 구성이 아니라 어디서든
# 설치되는 프레임워크다. 아래 두 값은 **기본적으로 비워/로컬호스트로 둔다**
# — 공개 도메인, 상위 게이트웨이 유무, TLS 종단 위치는 전부 온보딩이 결정할
# 항목이지 설치 시점에 미리 박아 둘 값이 아니다(docs/design/
# 10-core-architecture.md §2, IMPLEMENTATION-NOTES.md I5 §56 "온보딩이
# 결정할 항목" 목록 참고).
# ---------------------------------------------------------------------------

# osiris-gw가 127.0.0.1에 게시하는 호스트 포트. 설치 직후 여기로 바로
# 접속된다: http://localhost:${OSIRIS_GW_HOST_PORT}/ (콘솔 슬롯),
# /pre-status (플랫폼 상태), /omni/ (omniroute 관리 UI).
OSIRIS_GW_HOST_PORT=18280

# 콘솔/osiris-api가 자신의 공개 오리진으로 인지하는 값(Host 헤더 검증, 쿠키
# 도메인 등). 온보딩 전 기본값은 위 로컬 포트를 가리키는 localhost다 —
# 온보딩이 실제 공개 도메인을 정하면 그때 이 값을 갱신한다. 절대 미리
# 도메인을 박아 두지 말 것.
PUBLIC_ORIGIN=http://localhost:18280

# ---------------------------------------------------------------------------
# [선택 사항] 상위 리버스 프록시 오버레이 — docker-compose.dev-net.yml
#
# 이 값은 **기본 설치에는 필요 없다.** OSiris가 이미 어떤 외부 도커
# 네트워크(예: 다른 프로젝트들과 공유하는 리버스 프록시 서버) 위에서 돌아야
# 하는 배포에서만 채운다 — 채워져 있고 그 네트워크가 실제로 존재하면
# osiris-up이 `docker-compose.dev-net.yml`을 자동으로 함께 적용해
# osiris-gw를 그 네트워크에도 붙인다. 비워 두면(기본값) osiris-up은 이
# 오버레이를 아예 쓰지 않고, `docker compose up`도 이 네트워크의 존재
# 여부와 무관하게 성공한다.
# DEV_NET_NAME=dev-net

# ---------------------------------------------------------------------------
# 이미지 태그 — osiris-core/osiris-orchestrator는 build: 로 로컬 빌드된다
# (docker-compose.yml의 image: 필드는 빌드 산출물의 태그일 뿐, 레지스트리
# pull을 유발하지 않는다). osiris-api는 아직 빌드되지 않음 — 다음 워커가
# 이미지를 만들 때 compose의 주석을 해제한다.
# ---------------------------------------------------------------------------
TAG=dev

# ---------------------------------------------------------------------------
# Neo4j 자격증명 (§8.4) — 실제 값은 .env에서만, 반드시 변경할 것
# NEO4J_PASSWORD는 NEO4J_AUTH의 "/" 뒤와 반드시 같은 값이어야 한다(compose는
# 문자열을 분리할 수 없으므로 두 변수에 각각 명시한다). osiris-core가 이
# 값으로 bolt 접속한다.
# ---------------------------------------------------------------------------
NEO4J_AUTH=neo4j/CHANGE_ME_use_a_strong_password_min8
NEO4J_PASSWORD=CHANGE_ME_use_a_strong_password_min8

# ---------------------------------------------------------------------------
# osiris-core 그래프-쓰기 API 인증 토큰. 랜덤 생성 예:
#   openssl rand -base64 32 | tr -d '=+/\n'
# §2.6이 요구하는 "에이전트 대면 포트 + 토큰 인증"의 단순화 버전이다. 전체
# §8.5 genesis-token 창닫힘 모델(W1~W5)은 osiris-orchestrator 구현 시 이
# 정적 토큰을 대체해야 한다 — docs/design/IMPLEMENTATION-NOTES.md 참조.
# ---------------------------------------------------------------------------
CORE_API_TOKEN=CHANGE_ME_random_token

# ---------------------------------------------------------------------------
# 조직 규모 상한 (사용자 확정: 상주 에이전트 최대 4명)
# osiris-orchestrator의 수렴 루프가 이 값을 읽어 5번째 상주 에이전트 생성
# 요청을 거부한다(§3.3, G10 — 좌석 계산은 항상 백엔드). 사유는
# GET :8081/status (osiris-orchestrator, osiris-data 망 내부에서만 도달)와
# org.event.capacity_exceeded NATS 이벤트로 관측 가능.
# ---------------------------------------------------------------------------
OSIRIS_MAX_RESIDENT_AGENTS=4

# ---------------------------------------------------------------------------
# NATS 인증 (§7.3/D14) — 플랫폼 컴포넌트(osiris-core/osiris-orchestrator)
# 전용 정적 자격증명. 랜덤 생성 예: openssl rand -base64 24 | tr -d '=+/\n'
# 에이전트별 NATS 사용자는 orchestrator가 런타임에 생성해 파일로 주입한다
# (G5) — .env에는 두지 않는다.
# ---------------------------------------------------------------------------
NATS_CORE_PASSWORD=CHANGE_ME_random_password
NATS_ORCHESTRATOR_PASSWORD=CHANGE_ME_random_password
# osiris-api's static platform NATS user (§7.4/D19 SSE resume — see
# orchestrator/internal/natsauth/natsauth.go's osiris-api user block).
# Same category as the two above: sysadmin never sees/types this, it's
# purely inter-component auth.
NATS_API_PASSWORD=CHANGE_ME_random_password

# ---------------------------------------------------------------------------
# osiris-orchestrator가 Docker Engine API로 에이전트 컨테이너를 만들 때, 볼륨/
# bind mount의 host 경로를 이 값 기준으로 계산한다(docker-out-of-docker:
# orchestrator 컨테이너가 마운트한 도커 소켓은 HOST의 dockerd이므로, 그
# dockerd가 이해하는 경로는 orchestrator 컨테이너 내부 경로가 아니라 HOST의
# 절대경로다). 이 저장소를 체크아웃한 실제 HOST 절대경로로 바꿀 것.
# ---------------------------------------------------------------------------
HOST_PROJECT_DIR=/absolute/host/path/to/OSiris

# ---------------------------------------------------------------------------
# [보류 — osiris-orchestrator 구현 시 사용] 에이전트 기본 리소스 상한 (§1.4)
# ---------------------------------------------------------------------------
# AGENT_DEFAULT_MEMORY_MB=2048
# AGENT_DEFAULT_NANO_CPUS=1000000000

# ---------------------------------------------------------------------------
# [보류 — osiris-watchdog 구현 시 사용] 대역외 알림 자격증명
# watchdog은 컨테이너가 아니라 호스트 systemd 유닛이며 이번 단계 범위 밖이다.
# (docs/design/IMPLEMENTATION-NOTES.md 참조)
# ---------------------------------------------------------------------------
# WATCHDOG_NOTIFY_WEBHOOK=

# ---------------------------------------------------------------------------
# [I4] 에이전트 런타임 이미지 (§5.1)
# 권위는 Neo4j의 `:AIAgent.image`다(G4 — compose/env에 조직 정보를 두지 않는다).
# 아래 값은 `:AIAgent.image`가 비어 있을 때만 쓰이는 폴백이며,
# `bin/build-agent-image.sh`가 빌드하는 태그와 같아야 한다.
# ---------------------------------------------------------------------------
OSIRIS_AGENT_IMAGE=osiris/agent:dev

# ---------------------------------------------------------------------------
# [I4/I5] LLM 게이트웨이 (§9) — omniroute 경유 자격증명 "배달" 설정
#
# A4는 깨지지 않는다: osiris-orchestrator는 여기 있는 값을 파일로 써서
# 에이전트 컨테이너에 전달할 뿐이고, 이 이미지에는 claude 바이너리도 LLM
# 클라이언트도 없다(§9.1: "LLM 호출 자체는 어댑터를 통하지 않는다 — claude
# CLI가 ANTHROPIC_BASE_URL로 직접 친다").
#
# I5: 공용 omniroute(dev-net, `/v1/messages`가 404 "No active credentials for
# provider: osiris")를 가리키던 것을, OSiris 프레임워크 전용 인스턴스
# osiris-omniroute(osiris-llm 망, egress 프록시로만 도달 — docker-compose.yml
# 의 osiris-omniroute 서비스 주석과 IMPLEMENTATION-NOTES.md I5 참고)로
# 전환했다.
#
# OSIRIS_GATEWAY_TOKEN: 에이전트 자식 프로세스의 ANTHROPIC_AUTH_TOKEN이 되는
#   값. 실측 확인: `claude --bare`는 이 값을 `Authorization: Bearer <token>`
#   헤더로 POST <BASE_URL>/v1/messages 에 보낸다(§9.2 계약 2번 충족).
#   비워 두면 에이전트는 정상 기동하지만 실제 LLM 호출은 게이트웨이에서
#   401을 받는다. **이건 부트스트랩이 채우지 않는다** — 온보딩이
#   `omniroute/operations.mjs`의 `issueOrGetGatewayToken()`으로 osiris-agents
#   키를 발급/재조회하고, `applyGatewayTokenToEnv()`로 이 값을 반영한다
#   (osiris-orchestrator는 이 값을 컨테이너 환경변수로 읽으므로, 온보딩 뒤
#   `docker compose up -d osiris-orchestrator`로 재기동해야 반영된다).
#   §8.4가 요구하는 "에이전트별 24h 토큰, core가 IssueToken()으로 발급"은
#   core에 LLMGateway 어댑터가 없어 아직 구현되지 않았다(문서화된 격차,
#   지금은 전 에이전트가 이 하나의 정적 키를 공유한다).
#
# OSIRIS_GATEWAY_HEALTH_PATH: §9.2 계약 4번은 "GET /healthz 무인증"을 요구하고
#   코드 기본값도 /healthz다. omniroute(구/신 인스턴스 공통, 재실측 완료)는
#   /healthz -> 404, /api/health -> 401 이라 그 계약을 만족하지 않는다.
#   /v1/models 는 무인증 200이고 모델 호출을 유발하지 않으므로 그것을 쓴다 —
#   설계 위반이 아니라 게이트웨이 측 계약 미충족의 설정상 우회다.
# ---------------------------------------------------------------------------
OSIRIS_GATEWAY_BASE_URL=http://osiris-omniroute:20128/omni
OSIRIS_GATEWAY_TOKEN=
OSIRIS_GATEWAY_HEALTH_PATH=/v1/models

# ---------------------------------------------------------------------------
# [I5] osiris-omniroute — OSiris 전용 LLM 게이트웨이 인스턴스
#
# OSIRIS_OMNIROUTE_ADMIN_PASSWORD: **온보딩 소관 — 비워 둘 것(기본값).**
#   이건 프로바이더 키와 같은 부류다: 사람이 대면하는 자격증명이라 설치
#   스크립트가 미리 발명해 여기 남겨서는 안 된다(사용자가 두 번 지적한
#   패턴 — IMPLEMENTATION-NOTES.md I5 §64~§65). 비워 두면 omniroute
#   자신의 최초 접속 흐름이 대신한다(실측 확인: `/omni/`에 처음 접속하면
#   비밀번호가 없다는 것을 감지해 자체 온보딩 화면으로 안내한다) — 사람이
#   그 화면에서 직접 비밀번호를 정한다. `docker-compose.yml`의
#   `INITIAL_PASSWORD: ${OSIRIS_OMNIROUTE_ADMIN_PASSWORD:-}`는 이 값이 없어도
#   `docker compose up -d`가 정상 기동하도록 `:-`(옵셔널)를 쓴다 — `:?`로
#   강제하지 않는다. 이미 이 값으로 로그인해 쓰고 있는 기존 설치라면 그
#   값을 그대로 둬도 된다(강제 회전 없음) — 새 설치에서만 비워 둘 것.
#
#   **[osiris-api 워커 갱신, §1.0.4]** 이 변수를 osiris-api/operations.mjs가
#   "반복 인증"에 쓰는 일은 이제 없다 — `31-onboarding-boundary.md` 사건
#   4가 지적한 대로, 사람의 비밀번호를 OSiris가 계속 들고 재사용하는 것은
#   프로바이더 키를 들고 있는 것과 같은 부류의 실수였다. 이 변수가 여전히
#   여기 남아 있는 유일한 이유는 `docker-compose.yml`의 `INITIAL_PASSWORD`
#   부트스트랩 매핑(omniroute 자신의 최초 비밀번호를 미리 심고 싶을 때만
#   쓰는, 완전히 선택적인 경로) 때문이다 — 그 외에는 아무도 이 값을
#   저장하거나 재사용하지 않는다. 온보딩 0단계 화면은 이 값을 사람에게서
#   1회 입력받아 **즉시 `manage` 스코프 API 키로 교환하고 폐기**한다
#   (`POST /_api/onboarding/step0/omniroute-admin`) — 아래
#   `OSIRIS_OMNIROUTE_MANAGE_KEY`가 그 교환 산출물이다.
#
# 프로바이더 API 키(예: 실제 Anthropic 키)는 여기(.env)에도, 이 저장소의
# 어디에도 두지 않는다 — **omniroute 자신이 프로바이더 자격증명의 유일한
# 소유자**다(사용자 확정, 10-core-architecture.md §9 경계: "omniroute가
# 프로바이더 자격증명을 소유한다. OSiris는 자기 게이트웨이 토큰만 갖는다").
# omniroute를 도입한 이유 자체가 프로바이더 키를 한 곳에서 관리하기
# 위함이므로, OSiris가 그 키를 또 들고 있으면 시크릿 보관 지점이 하나 더
# 생길 뿐이다. **부트스트랩(`osiris-up`)은 프로바이더 키를 다루지 않는다**
# — 그건 온보딩 시점의 일이다: 온보딩 콘솔이 대표에게서 키를 받아
# `omniroute/operations.mjs`의 `registerProviderCredential()`로 omniroute의
# 관리 API에 바로 전달하고, 그 함수는 값을 파일이나 로그 어디에도 쓰지
# 않는다. 자세한 근거와 온보딩 인계 사항은 IMPLEMENTATION-NOTES.md I5
# §51~§53.
# ---------------------------------------------------------------------------
OSIRIS_OMNIROUTE_ADMIN_PASSWORD=

# OSIRIS_OMNIROUTE_MANAGE_KEY — the actual credential osiris-api/
# operations.mjs authenticates with, from the second call onward
# (30-onboarding-provisioning.md §1.0.4, 31-onboarding-boundary.md Q2b:
# "저장해야 하는 게 사람의 원본 자격증명이라면, 교환 경로가 있는가?" — yes,
# so the original password is never stored, only this). It is a `manage`-
# scoped omniroute API key — a machine credential exactly like
# OSIRIS_GATEWAY_TOKEN below, not a human-facing one, so unlike the password
# above it is legitimately fine for OSiris to hold in .env. Populated
# automatically by POST /_api/onboarding/step0/omniroute-admin the first
# time an operator supplies the omniroute admin password; empty by default.
OSIRIS_OMNIROUTE_MANAGE_KEY=

# ---------------------------------------------------------------------------
# omniroute 모드 — embedded(기본) | external
#
# embedded: 위 osiris-omniroute를 소스 빌드해 전용 인스턴스로 띄운다(지금까지의 기본).
# external: 이미 운용 중인 omniroute에 붙는다 — osiris-omniroute 설치(빌드·데이터
#   볼륨)를 skip하고, 같은 이름의 고정 대상 TCP 중계로 대체한다
#   (docker-compose.omniroute-external.yml, osiris-up이 자동 적용). 이때:
#   - OSIRIS_OMNIROUTE_EXTERNAL_NET: 외부 omniroute 컨테이너가 붙어 있는 docker 망
#     (osiris-up은 만들지 않는다 — 없으면 중단)
#   - OSIRIS_OMNIROUTE_EXTERNAL_ADDR: 그 망 안에서의 host:port (예: omniroute:20128)
#   - 위 OSIRIS_GATEWAY_BASE_URL과 아래 OSIRIS_OMNIROUTE_BASE_URL을
#     http://osiris-omniroute:20128 (`/omni` 없이)로 바꾼다 — 외부는 루트 경로로 서빙
#   - OSIRIS_GATEWAY_HEALTH_PATH는 외부 인스턴스에서 무인증 2xx인 경로로
#     (예: /healthz — 최근 omniroute는 /v1/models가 401)
#   - OSIRIS_GATEWAY_TOKEN·OSIRIS_OMNIROUTE_MANAGE_KEY는 외부 인스턴스가 발급한 값
#     (온보딩 0단계를 외부 기준으로 다시 수행)
# ---------------------------------------------------------------------------
OSIRIS_OMNIROUTE_MODE=embedded
OSIRIS_OMNIROUTE_EXTERNAL_NET=
OSIRIS_OMNIROUTE_EXTERNAL_ADDR=
# osiris-api(operations.mjs)가 쓰는 관리 API 주소. 비우면 compose 기본값(embedded용 /omni).
OSIRIS_OMNIROUTE_BASE_URL=

# ---------------------------------------------------------------------------
# [osiris-api, 6단계 워커] 온보딩 0단계 + 콘솔 REST/SSE + D19 SSE 재개
# (docs/design/30-onboarding-provisioning.md §1.0, 10-core-architecture.md
# §7.4/§9.6). 이 서비스가 실제로 필요로 하는 값 대부분은 위 섹션들(NEO4J_*,
# NATS_API_PASSWORD, OSIRIS_GATEWAY_*, OSIRIS_OMNIROUTE_*)이 이미 커버한다 —
# 여기는 osiris-api 고유의 것 하나뿐이다.
#
# 온보딩 관리자 설정 토큰(§8.5의 genesis 토큰과는 다른 것 — api/internal/
# adminauth/token.go의 doc comment 참고)은 .env가 아니라
# state/creds/admin/setup_token 파일에 있다(osiris-api가 최초 부팅 시
# 자동 생성, `docker logs osiris-api`가 경로만 알려주고 값은 절대 로그에
# 남기지 않는다) — `cat state/creds/admin/setup_token`으로 확인할 것.
# 온보딩 0단계 화면(`/_api/onboarding/*`, `/_api/events` 포함) 전체가 이
# 토큰의 `Authorization: Bearer` 헤더를 요구한다.
# ---------------------------------------------------------------------------
